# App
SECRET_KEY=muda-isto
DASHBOARD_USER=mailmkt
DASHBOARD_PASSWORD=escolhe-uma-password
PUBLIC_BASE_URL=http://91.99.167.243:8001

# Database (Docker Compose sets this automatically for services)
DATABASE_URL=postgresql+psycopg://mailmkt:mailmkt@db:5432/mailmkt

# UniOne (https://unione.io) — required for sending
UNIONE_API_KEY=
# Prefer api.unione.io; use eu1.unione.io or us1.unione.io if your account is regional
UNIONE_BASE_URL=https://api.unione.io/en/transactional/api/v1
UNIONE_FROM_EMAIL=noreply@teu-dominio-verificado.com
UNIONE_FROM_NAME=mail-mkt
UNIONE_REPLY_TO=
UNIONE_TRACK_LINKS=1
UNIONE_TRACK_READ=1
# Max 500 (UniOne limit). Start lower for warm-up.
UNIONE_BATCH_SIZE=100
UNIONE_BATCH_PAUSE_SEC=1
